---
import BoatSpecs from "@components/BoatSpecs.astro";
import PageHeader from "@components/PageHeader.astro";
import { boatGalleryImages } from "@data/site";
import Layout from "@layouts/Layout.astro";
import { imagePath } from "@lib/links";
---

<Layout
  title="The Boat | 29' SeaVee in Ocean City MD"
  description="Meet the 29 foot SeaVee center console used for private Ocean City, Maryland fishing charters and sunset cruises."
  canonicalPath="/boat/"
>
  <PageHeader
    title="The Boat"
    mascot="boat-mascot.png"
    mascotAlt="A delighted fish mascot looking up at a center-console fishing boat"
    background="section-art/boat-section-title.png"
    backgroundPosition="center top"
    showTitle={false}
  />

  <section class="section-pad">
    <div class="container-shell">
      <div class="grid gap-5 md:grid-cols-3">
        {
          boatGalleryImages.map((image) => (
            <figure class="card overflow-hidden">
              <img
                src={imagePath(image.src)}
                alt={image.alt}
                class="aspect-[4/3] w-full object-cover brightness-[1.06] saturate-[1.1] contrast-[1.02]"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="grid gap-1 p-4">
                <span class="text-sm font-black uppercase tracking-[0.14em] text-seafoam">{image.title}</span>
                <span class="text-sm leading-6 text-mist">{image.caption}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="mt-8 md:mt-10">
        <BoatSpecs />
      </div>
    </div>
  </section>
</Layout>
