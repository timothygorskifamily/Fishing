---
import GoogleDriveGallery from "@components/GoogleDriveGallery.astro";
import PageHeader from "@components/PageHeader.astro";
import { site } from "@data/site";
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Gallery | Ocean City MD Fishing Reports & Boat Photos"
  description="View boat, catch, and Ocean City water photos for a private SeaVee fishing charter gallery."
  canonicalPath="/gallery/"
>
  <PageHeader title="Gallery" />

  <GoogleDriveGallery folderId={site.galleryDriveFolderId} />
</Layout>
