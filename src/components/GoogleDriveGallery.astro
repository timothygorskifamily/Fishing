---
import GoogleDrivePhotoGrid from "@components/GoogleDrivePhotoGrid.astro";

interface Props {
  folderId: string;
}

const { folderId } = Astro.props;
const googleDriveApiKey = import.meta.env.PUBLIC_GOOGLE_DRIVE_API_KEY;
const embedUrl = `https://drive.google.com/embeddedfolderview?id=${folderId}#grid`;
---

<section class="section-pad">
  <div class="container-shell">
    <GoogleDrivePhotoGrid folderId={folderId} apiKey={googleDriveApiKey}>
      <div class="overflow-hidden rounded-lg border border-sky-100 bg-white shadow-[0_18px_45px_rgba(16,80,103,0.12)]">
        <iframe
          src={embedUrl}
          title="Ocean City Guide Service Google Drive photo gallery"
          class="h-[82svh] min-h-[42rem] w-full bg-white"
          loading="lazy"
        ></iframe>
      </div>
    </GoogleDrivePhotoGrid>
  </div>
</section>
