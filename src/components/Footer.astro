---
import { site } from "@data/site";
import { emailHref, imagePath, phoneHref } from "@lib/links";
import { Mail, MapPin, Phone } from "@lucide/astro";

const socials = [
  { label: "Instagram", href: site.instagramUrl, icon: "instagram" },
  { label: "Facebook", href: site.facebookUrl, icon: "facebook" }
].filter((social) => social.href && social.href !== "#");
---

<footer class="border-t border-white/10 bg-[#071b25] pb-24 pt-14 md:pb-10">
  <div class="container-shell">
    <div class="grid gap-10 lg:grid-cols-[minmax(14rem,0.65fr)_minmax(0,1.35fr)]">
      <div>
        <h2 class="text-sm font-black uppercase tracking-[0.16em] text-white">Contact</h2>
        <ul class="mt-4 grid gap-3 text-sm text-mist">
          <li>
            <a class="inline-flex items-center gap-2 hover:text-white" href={phoneHref(site.phone)}>
              <Phone class="size-4 text-seafoam" aria-hidden="true" />
              {site.phone}
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-2 hover:text-white" href={emailHref(site.email)}>
              <Mail class="size-4 text-seafoam" aria-hidden="true" />
              {site.email}
            </a>
          </li>
          <li>
            <a class="inline-flex items-start gap-2 hover:text-white" href={site.googleMapsUrl} target="_blank" rel="noreferrer">
              <MapPin class="mt-0.5 size-4 shrink-0 text-seafoam" aria-hidden="true" />
              <span>{site.marinaAddress}</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="min-w-0">
        <h2 class="text-sm font-black uppercase tracking-[0.16em] text-white">Social</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noreferrer"
                aria-label={`${site.businessName} on ${social.label}`}
                title={social.label}
                class="group inline-flex size-12 items-center justify-center rounded-full border border-white/12 bg-white/8 text-white shadow-lift transition hover:-translate-y-0.5 hover:border-seafoam/45 hover:bg-seafoam hover:text-[#071b25] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-seafoam"
              >
                {social.icon === "instagram" ? (
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect width="18" height="18" x="3" y="3" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                ) : (
                  <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M14 8.2V6.7c0-.7.5-1.2 1.2-1.2H17V2.3c-1-.1-1.8-.2-2.6-.2-2.7 0-4.5 1.6-4.5 4.4v1.7H7v3.6h2.9V22h3.8V11.8h3l.5-3.6H14Z" />
                  </svg>
                )}
                <span class="sr-only">{social.label}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="wave-rule my-10"></div>
    <div class="flex flex-col gap-3 text-xs text-mist md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3">
        <img
          src={imagePath(site.logoImage)}
          alt=""
          class="hidden h-12 w-auto rounded bg-white p-1 md:block"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
        <p>&copy; {new Date().getFullYear()} {site.businessName}. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
