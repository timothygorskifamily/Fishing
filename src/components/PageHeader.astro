---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="border-b border-sky-100 bg-white">
  <div class="container-shell py-10 text-center md:py-14">
    <div class="mx-auto mb-4 h-px w-16 bg-seafoam"></div>
    <h1 class="font-display text-4xl font-black leading-none text-ink md:text-6xl">
      {title}
    </h1>
    <div class="mx-auto mt-4 h-px w-24 bg-gold"></div>
  </div>
</section>
